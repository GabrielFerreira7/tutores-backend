# Copie este arquivo para ".env" e preencha com valores reais (nunca commite o .env real).

# --- Admin ---
ADMIN_API_KEY=change-me-admin-key

# --- Persistência ---
# OBRIGATÓRIA: a aplicação não sobe sem DATABASE_URL configurada (ver Settings em
# app/config.py — sem valor aqui ela cai no default abaixo, mas defina explicitamente).
#
# Padrão (zero setup, recomendado para rodar local/demo): SQLite em arquivo. O diretório
# "data/" e o arquivo .db são criados automaticamente no primeiro start (ver app/db.py) —
# não é preciso provisionar nada antes.
DATABASE_URL=sqlite:///./data/tutors.db
#
# Alternativa: PostgreSQL. Se o seu ambiente não tiver um Postgres disponível, suba um
# descartável com o profile do compose.yaml deste repo: `docker compose --profile postgres up -d`
# (ver README.md, seção "Banco de dados"). Depois, aponte para ele:
# DATABASE_URL=postgresql+psycopg://tutores:tutores@localhost:5432/tutores
# (troque "localhost" por "db" se o próprio backend também estiver rodando via compose)
# Necessário instalar o driver: pip install "psycopg[binary]==3.2.3" (ver requirements.txt)

# --- LLM ---
# Formato "provider:model" conforme pydantic-ai (ex.: anthropic:claude-haiku-4-5-20251001,
# openai:gpt-4o-mini). A chave de API correspondente é lida pelo SDK do provedor a partir
# da sua variável de ambiente padrão — NÃO é lida diretamente por esta aplicação.
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#
# Sem chave de nenhum provedor pago? Use um modelo pequeno rodando local via Ollama —
# testado e funcional para CONVERSA (tutores sem fonte de conhecimento). Ver README.md,
# seção "Sem chave de LLM? Use um modelo local (Ollama)" para a ressalva importante sobre
# tool calling (fetch_source) antes de usar isso com um tutor que tem fontes cadastradas.
# 1. docker compose --profile local-llm up -d ollama
# 2. docker exec -it $(docker compose ps -q ollama) ollama pull qwen2.5:0.5b
# 3. Descomente as duas linhas abaixo (e comente LLM_MODEL/ANTHROPIC_API_KEY acima):
# LLM_MODEL=ollama:qwen2.5:0.5b
# OLLAMA_BASE_URL=http://ollama:11434/v1
# (se o backend NÃO estiver rodando via docker compose, use "http://localhost:11434/v1" —
# a porta do Ollama também é publicada no host)

LLM_TIMEOUT_SECONDS=30

# --- Fontes de conhecimento (fetch simples, sem vector DB) ---
MAX_SOURCE_FETCH_BYTES=51200
SOURCE_FETCH_TIMEOUT_SECONDS=8
SOURCE_CACHE_TTL_SECONDS=3600

# --- Conversação ---
CHAT_HISTORY_LIMIT=20

# --- CORS (cenário de iframe) ---
# "*" libera qualquer origem (ok para demo local); em produção, restrinja aos domínios
# dos integradores conhecidos.
CORS_ALLOWED_ORIGINS=*

# --- Rate limit da rota pública de chat ---
CHAT_RATE_LIMIT=20/minute

# --- URL do frontend, usada apenas para montar o snippet de embed ---
FRONTEND_BASE_URL=http://localhost:5173

LOG_LEVEL=INFO
