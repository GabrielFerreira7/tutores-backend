# Copie este arquivo para ".env" e preencha com valores reais (nunca commite o .env real).

# --- Admin ---
ADMIN_API_KEY=change-me-admin-key

# --- Persistência ---
DATABASE_URL=sqlite:///./data/tutors.db

# --- LLM ---
# Formato "provider:model" conforme pydantic-ai (ex.: anthropic:claude-haiku-4-5-20251001,
# openai:gpt-4o-mini). A chave de API correspondente é lida pelo SDK do provedor a partir
# da sua variável de ambiente padrão — NÃO é lida diretamente por esta aplicação.
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

LLM_TIMEOUT_SECONDS=30

# --- Fontes de conhecimento (fetch simples, sem vector DB) ---
MAX_SOURCE_FETCH_BYTES=51200
SOURCE_FETCH_TIMEOUT_SECONDS=8
SOURCE_CACHE_TTL_SECONDS=3600

# --- Conversação ---
CHAT_HISTORY_LIMIT=20

# --- CORS (cenário de iframe) ---
# "*" libera qualquer origem (ok para demo local); em produção, restrinja aos domínios
# dos integradores conhecidos.
CORS_ALLOWED_ORIGINS=*

# --- Rate limit da rota pública de chat ---
CHAT_RATE_LIMIT=20/minute

# --- URL do frontend, usada apenas para montar o snippet de embed ---
FRONTEND_BASE_URL=http://localhost:5173

LOG_LEVEL=INFO
